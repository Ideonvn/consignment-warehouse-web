# Base URL of the Consignment Warehouse REST API (no trailing slash).
# These are inlined into the client bundle at build time, so restart `next dev`
# (or rebuild) after changing them. To test from another device on the LAN, set
# both to the machine's IP rather than localhost — and add that origin to
# `allowedDevOrigins` in next.config.ts.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket endpoint for live bid / lot events.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# How to pay, shown on the account statement and when a bid is refused for a
# shortfall. Payment is arranged manually with the operator today, so this is
# copy rather than a payment flow. Falls back to a generic "contact the team"
# line when unset — see lib/config/payments.ts.
NEXT_PUBLIC_PAYMENT_INSTRUCTIONS=

# Digits in the login OTP and email verification code inputs. Default 6, which
# is what the backend issues. Override it only for a local backend with
# OTP_DEV_CODE set to something shorter — the seeded local setup returns 0000,
# so a local .env.local wants 4. See lib/auth/otpCode.ts.
NEXT_PUBLIC_OTP_CODE_LENGTH=
