# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored; this file is not.
#
# Nothing here may be secret. Every NEXT_PUBLIC_* value is compiled into the browser
# bundle and readable by anyone using the app, and Terraform keeps variable values in
# state. The GitHub token, if you use one at all, belongs in TF_VAR_github_access_token
# for a single apply — see README.md → Connecting the repository.

# Account 982055099067. Amplify Hosting is not offered in af-south-1, where the API runs;
# eu-west-1 is the closest well-connected supported region. See README.md → Region.
aws_region  = "eu-west-1"
environment = "prod"
app_name    = "consignment-warehouse-web"

# Casing is GitHub's own, from `git remote -v`. The repository is private, so Amplify
# needs a connection before it can clone or receive pushes — README.md → Connecting the
# repository covers both routes and what each one costs.
repository_url   = "https://github.com/Ideonvn/consignment-warehouse-web"
main_branch_name = "main"

# The app is served from the APEX: https://consignment-warehouse.com. No bid., no www.
# An empty prefix is what the AWS provider expects for an apex association.
#
# The apex is also why the hosted zone was moved to Route 53: a CNAME is invalid at a zone
# apex, so this would otherwise need ANAME/ALIAS support from the DNS provider. See
# README.md → DNS and the apex.
domain_name      = "consignment-warehouse.com"
subdomain_prefix = ""

# The live API, same registrable domain as this app so the refresh cookie survives.
# https/wss are enforced by variable validation: a plain-http or ws:// call from an https
# page is blocked as mixed content, and the live bid layer then silently never connects.
api_base_url = "https://api.consignment-warehouse.com/api/v1"
ws_url       = "wss://api.consignment-warehouse.com/api/v1/ws"

# PLACEHOLDER — replace in terraform.tfvars, which is gitignored, and nowhere else.
# Real banking details must not land in a tracked file. Left empty, the app falls back to
# an honest "contact the warehouse" line rather than inventing details, which is a worse
# outcome than the real wording but a safe one.
payment_instructions = "REPLACE ME — bank, account number, branch code, and a note to quote the payment reference."

# Previews inherit the production API, so a branch build would place real bids.
enable_auto_branch_creation = false
enable_webhook              = false

# NOTE: there is deliberately no NEXT_PUBLIC_OTP_CODE_LENGTH setting, and the module
# refuses one. Production OTPs are six digits and the app already defaults to six; a 4
# here renders four boxes for a six-digit code and nobody can sign in.
